# --------------------------------------------------------------------
# Raw data files (too large for git — get them from Kaggle).
# IPL.csv is ~105MB, exceeds GitHub's 100MB file limit.
# --------------------------------------------------------------------
data/raw/*.csv
data/raw/*.zip
!data/raw/.gitkeep

# --------------------------------------------------------------------
# We INTENTIONALLY commit the small artifacts below so the Streamlit
# Cloud deployment and the README figures work out of the box.
# Tracked: data/processed/*.parquet   (~1.6 MB)
# Tracked: models/*.joblib            (~32 KB)
# Tracked: reports/figures/*.png      (used in README)
# Tracked: reports/tables/*.csv       (small summaries)
# --------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml
